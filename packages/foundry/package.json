{
  "name": "@explorer-verify/foundry",
  "version": "0.4.0",
  "description": "Find a contract's build files in a Foundry project and build the explorer-verify input from them.",
  "keywords": [
    "ethereum",
    "evm",
    "smart-contracts",
    "verification",
    "source-verification",
    "foundry",
    "forge",
    "solidity"
  ],
  "homepage": "https://github.com/aelmanaa/explorer-verify/blob/main/docs/user/guides/verify-from-a-foundry-project.md",
  "bugs": {
    "url": "https://github.com/aelmanaa/explorer-verify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aelmanaa/explorer-verify.git",
    "directory": "packages/foundry"
  },
  "license": "MIT",
  "author": {
    "name": "Amine El Manaa",
    "url": "https://github.com/aelmanaa"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/",
    "src/",
    "!**/*.test.*",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "node -e \"for (const p of ['dist','coverage']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "test": "pnpm run test:unit",
    "test:unit": "node ../../scripts/node-test.ts unit \"test/unit/**/*.test.ts\"",
    "test:randomize": "node ../../scripts/node-test.ts unit --test-randomize \"test/unit/**/*.test.ts\"",
    "coverage": "c8 --check-coverage node --test \"test/unit/**/*.test.ts\"",
    "pkg:check": "publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "peerDependencies": {
    "explorer-verify": "workspace:^"
  },
  "devDependencies": {
    "c8": "catalog:",
    "explorer-verify": "workspace:^"
  }
}
