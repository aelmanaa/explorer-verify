{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "plugins": ["@stryker-mutator/tap-runner"],
  "mutate": [
    "src/backends/sourcify.ts",
    "src/backends/common.ts",
    "src/flow/verify.ts",
    "src/flow/stored.ts",
    "src/flow/status.ts",
    "src/compiler-kinds.ts",
    "src/redact.ts",
    "src/errors.ts",
    "src/observe.ts",
    "src/http/fetch.ts",
    "src/http/api-keys.ts",
    "src/routing/resolve.ts",
    "src/flow/verify-each.ts",
    "src/flow/link-proxy.ts",
    "src/backends/proxy-common.ts",
    "src/backends/proxy-etherscan.ts",
    "src/backends/proxy-blockscout.ts",
    "src/backends/proxy-sourcify.ts",
    "src/backends/etherscan.ts",
    "src/backends/etherscan-compatible.ts",
    "src/backends/routescan.ts",
    "src/backends/blockscout.ts",
    "src/server/handler.ts",
    "src/envelope.ts",
    "src/http/rpc.ts",
    "src/flow/dry-run.ts",
    "src/flow/handle.ts",
    "src/flow/format-handle.ts",
    "src/input/validate.ts",
    "src/input/constructor-args.ts",
    "src/input/build.ts",
    "src/input/metadata.ts",
    "src/input/libraries.ts",
    "src/input/paths.ts",
    "src/flow/check-handle.ts",
    "src/core/options.ts",
    "src/core/parts.ts",
    "src/flow/defaults.ts",
    "src/routing/load-table.ts",
    "src/clients/*.ts"
  ],
  "tap": {
    "testFiles": ["test/unit/!(skill|user-docs|options-types|core-types).test.ts"],
    "nodeArgs": ["--test-reporter=tap", "-r", "{{hookFile}}", "{{testFile}}"],
    "forceBail": true
  },
  "coverageAnalysis": "perTest",
  "incremental": true,
  "timeoutFactor": 2,
  "timeoutMS": 15000,
  "checkers": [],
  "inPlace": true,
  "concurrency": 4,
  "reporters": ["clear-text", "progress", "html", "json"],
  "thresholds": { "high": 90, "low": 80, "break": null }
}
