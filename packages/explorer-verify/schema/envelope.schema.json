{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "explorer-verify envelope",
  "description": "The JSON document that toEnvelope() returns and that the CLI prints on stdout with --json (R-AX-5). ok is true exactly when the exit code is 0. Within schemaVersion 1, a release may add fields, error codes and backends, and changes nothing else, so readers ignore fields they do not know and treat an unknown error code by its retryable value and the exit code. Keys appear in the order the properties below list them.",
  "oneOf": [
    {
      "description": "verified or already-verified: exit code 0.",
      "type": "object",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "ok": { "const": true },
        "result": { "$ref": "#/$defs/success" }
      },
      "required": ["schemaVersion", "ok", "result"],
      "not": { "properties": { "error": {} }, "required": ["error"] }
    },
    {
      "description": "failed: the explorer rejected the submission. Exit code 1.",
      "type": "object",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "ok": { "const": false },
        "result": { "$ref": "#/$defs/failure" }
      },
      "required": ["schemaVersion", "ok", "result"],
      "not": { "properties": { "error": {} }, "required": ["error"] }
    },
    {
      "description": "A dry run: toEnvelope() of the result of dryRun(), which the CLI prints for verify --dry-run. Nothing was submitted. Exit code 0.",
      "type": "object",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "ok": { "const": true },
        "result": { "$ref": "#/$defs/dryRun" }
      },
      "required": ["schemaVersion", "ok", "result"],
      "not": { "properties": { "error": {} }, "required": ["error"] }
    },
    {
      "description": "Several backends: toEnvelope() of the result of verifyEach(), which the CLI prints for verify with --backend repeated. ok is true and the exit code 0 only when every outcome is ok. Otherwise the exit code is the first of 6, 4, 3, 2, 5, 1 and 130 that any outcome has, each outcome's code being that of its result or error. A non-zero code names only the first outcome with that code: read result.outcomes for every backend.",
      "type": "object",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "ok": { "type": "boolean" },
        "result": { "$ref": "#/$defs/each" }
      },
      "required": ["schemaVersion", "ok", "result"],
      "not": { "properties": { "error": {} }, "required": ["error"] }
    },
    {
      "description": "An error from the catalogue. The exit code depends on error.code.",
      "type": "object",
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/error" },
        "nextCommand": {
          "description": "The CLI only: the command to run next, as an argv array that starts with explorer-verify, when one exists. For not-confirmed and a cancelled run with one handle it calls explorer-verify status with the handle, which never submits. It holds no API key, RPC URL or file path. toEnvelope() never sets it.",
          "type": "array",
          "minItems": 2,
          "items": { "type": "string" }
        }
      },
      "required": ["schemaVersion", "ok", "error"],
      "not": { "properties": { "result": {} }, "required": ["result"] }
    }
  ],
  "$defs": {
    "schemaVersion": {
      "description": "The version of this envelope format. A change that removes or changes a field raises it.",
      "const": 1
    },
    "backend": {
      "description": "The backend that answered. A later release may add a backend. Known values in this release: etherscan-v2, etherscan-compatible, blockscout, blockscout-hosted, sourcify, routescan.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "success": {
      "description": "A VerifyResult whose status is verified or already-verified.",
      "type": "object",
      "properties": {
        "status": { "enum": ["verified", "already-verified"] },
        "backend": { "$ref": "#/$defs/backend" },
        "match": { "enum": ["exact", "partial"] },
        "explorerUrl": {
          "description": "The public page of the contract. Absent when the library knows none.",
          "type": "string"
        }
      },
      "required": ["status", "backend", "match"]
    },
    "failure": {
      "description": "A VerifyResult whose status is failed.",
      "type": "object",
      "properties": {
        "status": { "const": "failed" },
        "backend": { "$ref": "#/$defs/backend" },
        "reason": {
          "description": "Why the explorer rejected the submission, with API keys removed.",
          "type": "string"
        }
      },
      "required": ["status", "backend", "reason"]
    },
    "dryRun": {
      "description": "A DryRunResult: where verify would go and what the explorer holds now. Nothing was submitted.",
      "type": "object",
      "properties": {
        "status": { "const": "dry-run" },
        "backend": { "$ref": "#/$defs/backend" },
        "apiHost": {
          "description": "The API host verify would send to, such as sourcify.dev, with the port when it is not the scheme's default.",
          "type": "string"
        },
        "lookup": {
          "description": "exact or partial: the explorer holds a match, so verify would not submit. none: it holds none, so verify would submit. skipped: the backend needs an API key and none is set, so no request was sent.",
          "enum": ["exact", "partial", "none", "skipped"]
        },
        "explorerUrl": {
          "description": "The public page of the contract, for a match. Absent when the library knows none.",
          "type": "string"
        },
        "routedBy": {
          "description": "How the backend was chosen. caller: the caller named it (route.backend, --backend). table: the routing table picked the first backend the chain lists that needs no key or has one. fallback: the chain has no row and the Sourcify fallback was allowed. api-url: the caller named the server (route.apiUrl, --api-url).",
          "enum": ["caller", "table", "fallback", "api-url"]
        }
      },
      "required": ["status", "backend", "apiHost", "lookup"]
    },
    "each": {
      "description": "A VerifyEachResult: one outcome per backend, in the order the call listed them.",
      "type": "object",
      "properties": {
        "outcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/outcome" } }
      },
      "required": ["outcomes"]
    },
    "outcome": {
      "description": "What one backend of a verifyEach() call ended with. Keys appear in the order backend, ok, then result or error.",
      "oneOf": [
        {
          "description": "verified or already-verified.",
          "type": "object",
          "properties": {
            "backend": { "$ref": "#/$defs/backend" },
            "ok": { "const": true },
            "result": { "$ref": "#/$defs/success" }
          },
          "required": ["backend", "ok", "result"],
          "not": { "properties": { "error": {} }, "required": ["error"] }
        },
        {
          "description": "failed: the explorer rejected the submission.",
          "type": "object",
          "properties": {
            "backend": { "$ref": "#/$defs/backend" },
            "ok": { "const": false },
            "result": { "$ref": "#/$defs/failure" }
          },
          "required": ["backend", "ok", "result"],
          "not": { "properties": { "error": {} }, "required": ["error"] }
        },
        {
          "description": "The call on this backend threw. A not-confirmed error carries the handle that resumes this backend alone.",
          "type": "object",
          "properties": {
            "backend": { "$ref": "#/$defs/backend" },
            "ok": { "const": false },
            "error": { "$ref": "#/$defs/error" }
          },
          "required": ["backend", "ok", "error"],
          "not": { "properties": { "result": {} }, "required": ["result"] }
        }
      ]
    },
    "error": {
      "description": "ExplorerVerifyError.toJSON(): the error without its cause or stack, with its details redacted and each handle in its one-line form.",
      "type": "object",
      "properties": {
        "code": {
          "description": "The stable error code. Each has its own page, docs/user/reference/errors/<code>.md. A later release may add a code; treat an unknown one by retryable and the exit code. Known values in this release: invalid-input, not-confirmed, unsupported-chain, network, rate-limited, timeout, unexpected-response, in-progress, unknown-state, job-not-found, cancelled, incomplete-input, insufficient-artifact, unsupported-compiler, verification-inconclusive, source-mismatch, missing-api-key, api-key-rejected, quota-exceeded, internal-error, no-metadata-hash, metadata-unavailable, constructor-args-unavailable, proxy-link-pending, proxy-link-unknown-state, handler-refused.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "message": { "description": "What went wrong.", "type": "string" },
        "hint": { "description": "What to do next.", "type": "string", "minLength": 1 },
        "docsUrl": {
          "description": "The code's own page in the error reference.",
          "type": "string",
          "pattern": "^https://"
        },
        "retryable": {
          "description": "Whether trying again may succeed without changing the input. For not-confirmed, try checkStatus with the handle, not a new verify.",
          "type": "boolean"
        },
        "handle": {
          "description": "The handle in its one-line form, ev1:<backend>:<chainId>:<address>:<jobId>, when the error carries one.",
          "type": "string",
          "pattern": "^ev1:"
        },
        "handles": {
          "description": "cancelled only, for a run on several backends: each backend that accepted a submission and had not ended before the cancel, with its handle. Resume each one with checkStatus or explorer-verify status.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "backend": { "$ref": "#/$defs/backend" },
              "handle": { "type": "string", "pattern": "^ev1:" }
            },
            "required": ["backend", "handle"]
          }
        },
        "details": {
          "description": "The code's data, redacted (R-SEC-1), with the same fields as ErrorDetails in the library and each handle in its one-line form. details.code equals code. The fields of each known code are listed below; an unknown code's details are an object with its code.",
          "type": "object",
          "properties": { "code": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
          "required": ["code"]
        }
      },
      "required": ["code", "message", "hint", "docsUrl", "retryable", "details"],
      "allOf": [
        {
          "if": { "properties": { "code": { "const": "invalid-input" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "invalid-input" },
                  "issues": {
                    "description": "Every problem found, in field order.",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "field": {
                          "description": "The field, as a dotted path or a CLI flag.",
                          "type": "string"
                        },
                        "message": {
                          "description": "What is wrong with it. Never repeats the value.",
                          "type": "string"
                        }
                      },
                      "required": ["field", "message"]
                    }
                  }
                },
                "required": ["code", "issues"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "not-confirmed" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "not-confirmed" },
                  "handle": { "$ref": "#/$defs/handleLine" }
                },
                "required": ["code", "handle"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "unsupported-chain" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "unsupported-chain" },
                  "chainId": { "type": "number" },
                  "backend": { "$ref": "#/$defs/backend" }
                },
                "required": ["code", "chainId", "backend"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "network" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "network" },
                  "backend": { "$ref": "#/$defs/backend" },
                  "attempts": { "type": "number" }
                },
                "required": ["code", "backend", "attempts"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "rate-limited" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "rate-limited" },
                  "backend": { "$ref": "#/$defs/backend" },
                  "retryAfterMs": { "type": "number" },
                  "attempts": { "type": "number" }
                },
                "required": ["code", "backend"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "timeout" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "timeout" },
                  "backend": { "$ref": "#/$defs/backend" },
                  "timeoutMs": { "type": "number" }
                },
                "required": ["code", "backend", "timeoutMs"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "unexpected-response" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "unexpected-response" },
                  "backend": { "$ref": "#/$defs/backend" },
                  "status": { "type": "number" },
                  "excerpt": { "type": "string" },
                  "retryAfterMs": { "type": "number" },
                  "attempts": { "type": "number" }
                },
                "required": ["code", "backend", "status", "excerpt"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "in-progress" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "in-progress" },
                  "backend": { "$ref": "#/$defs/backend" }
                },
                "required": ["code", "backend"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "unknown-state" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "unknown-state" },
                  "handle": { "$ref": "#/$defs/handleLine" },
                  "excerpt": { "type": "string" }
                },
                "required": ["code", "handle", "excerpt"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "job-not-found" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "job-not-found" },
                  "handle": { "$ref": "#/$defs/handleLine" }
                },
                "required": ["code", "handle"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "cancelled" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "cancelled" },
                  "handle": { "$ref": "#/$defs/handleLine" },
                  "handles": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/handleLine" }
                  }
                },
                "required": ["code"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "incomplete-input" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "incomplete-input" },
                  "field": { "enum": ["input", "compilerVersion", "contract", "sources"] },
                  "candidates": { "type": "array", "items": { "type": "string" } }
                },
                "required": ["code", "field", "candidates"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "insufficient-artifact" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "insufficient-artifact" },
                  "field": { "const": "input" }
                },
                "required": ["code", "field"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "unsupported-compiler" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "unsupported-compiler" },
                  "field": { "type": "string" }
                },
                "required": ["code", "field"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "verification-inconclusive" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "verification-inconclusive" },
                  "backend": { "$ref": "#/$defs/backend" },
                  "reason": { "type": "string" }
                },
                "required": ["code", "backend", "reason"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "source-mismatch" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "source-mismatch" },
                  "path": { "type": "string" },
                  "expected": { "type": "string", "pattern": "^0x([0-9a-f]{64})?$" },
                  "actual": { "type": "string", "pattern": "^0x([0-9a-f]{64})?$" }
                },
                "required": ["code", "path", "expected", "actual"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "missing-api-key" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "missing-api-key" },
                  "backend": { "$ref": "#/$defs/backend" }
                },
                "required": ["code", "backend"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "api-key-rejected" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "api-key-rejected" },
                  "backend": { "$ref": "#/$defs/backend" }
                },
                "required": ["code", "backend"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "quota-exceeded" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "quota-exceeded" },
                  "backend": { "$ref": "#/$defs/backend" }
                },
                "required": ["code", "backend"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "internal-error" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": { "code": { "const": "internal-error" } },
                "required": ["code"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "no-metadata-hash" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "no-metadata-hash" },
                  "found": { "enum": ["no-code", "no-metadata", "version-only"] }
                },
                "required": ["code", "found"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "metadata-unavailable" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "metadata-unavailable" },
                  "hash": { "type": "string" },
                  "attempts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "source": { "enum": ["rpc", "ipfs", "sourcify"] },
                        "outcome": {
                          "enum": [
                            "not-found",
                            "hash-mismatch",
                            "not-metadata",
                            "unavailable",
                            "timeout"
                          ]
                        },
                        "status": { "type": "number" }
                      },
                      "required": ["source", "outcome"]
                    }
                  }
                },
                "required": ["code", "hash", "attempts"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "constructor-args-unavailable" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "constructor-args-unavailable" },
                  "reason": { "enum": ["prefix-mismatch", "bad-length"] }
                },
                "required": ["code", "reason"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "proxy-link-pending" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "proxy-link-pending" },
                  "backend": { "$ref": "#/$defs/backend" }
                },
                "required": ["code", "backend"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "code": { "const": "proxy-link-unknown-state" } },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "proxy-link-unknown-state" },
                  "backend": { "$ref": "#/$defs/backend" },
                  "excerpt": { "type": "string" }
                },
                "required": ["code", "backend", "excerpt"]
              }
            }
          }
        },
        {
          "if": { "properties": { "code": { "const": "handler-refused" } }, "required": ["code"] },
          "then": {
            "properties": {
              "details": {
                "type": "object",
                "properties": {
                  "code": { "const": "handler-refused" },
                  "backend": { "$ref": "#/$defs/backend" },
                  "status": { "type": "number" },
                  "excerpt": { "type": "string" },
                  "handlerCode": { "type": "string", "pattern": "^([a-z][a-z-]{0,39})?$" }
                },
                "required": ["code", "backend", "status", "excerpt", "handlerCode"]
              }
            }
          }
        }
      ]
    },
    "handleLine": {
      "description": "A handle in its one-line form, ev1:<backend>:<chainId>:<address>:<jobId>.",
      "type": "string",
      "pattern": "^ev1:"
    }
  }
}
