{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Runs in browsers, edge runtimes and Node (decision 0002): web-platform globals only, no Node types.
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "include": ["src"]
}
