{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../node_modules/.cache/tsbuild/explorer-verify-test",
    "tsBuildInfoFile": "../../node_modules/.cache/tsbuild/explorer-verify-test.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    // test/browser/scenario.ts imports the package by name, and esbuild bundles it from dist/. For
    // types, the name maps to the sources, so lint and typecheck pass before a build.
    "paths": {
      "explorer-verify": ["./src/index.ts"],
      "explorer-verify/server": ["./src/server/handler.ts"],
      "explorer-verify/resolve": ["./src/input/resolvers/bytecode.ts"],
      "explorer-verify/core": ["./src/core/index.ts"],
      "explorer-verify/table": ["./src/core/table.ts"],
      "explorer-verify/clients/*": ["./src/clients/*.ts"]
    }
  },
  // Tests run on Node and import the sources directly. tsconfig.build.json checks src/ again
  // without Node types, which keeps the shipped code runtime-neutral.
  // The browser smoke scenario imports the keccak-256 vectors as a JSON module.
  "include": ["src", "src/routing/table.json", "test", "test/fixtures/keccak256-vectors.json"]
}
