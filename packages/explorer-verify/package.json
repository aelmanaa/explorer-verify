{
  "name": "explorer-verify",
  "version": "0.3.0",
  "description": "Verify deployed smart-contract source on Etherscan, Blockscout, Sourcify and Routescan from a browser, a backend or a CLI, with one API.",
  "keywords": [
    "ethereum",
    "evm",
    "smart-contracts",
    "verification",
    "source-verification",
    "etherscan",
    "blockscout",
    "sourcify",
    "routescan",
    "solidity",
    "block-explorer"
  ],
  "homepage": "https://github.com/aelmanaa/explorer-verify#readme",
  "bugs": {
    "url": "https://github.com/aelmanaa/explorer-verify/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aelmanaa/explorer-verify.git",
    "directory": "packages/explorer-verify"
  },
  "license": "MIT",
  "author": {
    "name": "Amine El Manaa",
    "url": "https://github.com/aelmanaa"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/src/index.d.ts",
  "typesVersions": {
    "*": {
      "handle": [
        "./dist/src/entries/handle.d.ts"
      ],
      "errors": [
        "./dist/src/entries/errors.d.ts"
      ],
      "backends": [
        "./dist/src/entries/backends.d.ts"
      ],
      "envelope": [
        "./dist/src/entries/envelope.d.ts"
      ],
      "server": [
        "./dist/src/server/handler.d.ts"
      ],
      "resolve": [
        "./dist/src/input/resolvers/bytecode.d.ts"
      ],
      "core": [
        "./dist/src/core/index.d.ts"
      ],
      "table": [
        "./dist/src/core/table.d.ts"
      ],
      "clients/sourcify": [
        "./dist/src/clients/sourcify.d.ts"
      ],
      "clients/etherscan-v2": [
        "./dist/src/clients/etherscan-v2.d.ts"
      ],
      "clients/etherscan-compatible": [
        "./dist/src/clients/etherscan-compatible.d.ts"
      ],
      "clients/routescan": [
        "./dist/src/clients/routescan.d.ts"
      ],
      "clients/blockscout": [
        "./dist/src/clients/blockscout.d.ts"
      ],
      "envelope.schema.json": [
        "./schema/envelope.schema.json"
      ],
      "event.schema.json": [
        "./schema/event.schema.json"
      ],
      "input.schema.json": [
        "./schema/input.schema.json"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./handle": {
      "types": "./dist/src/entries/handle.d.ts",
      "default": "./dist/src/entries/handle.js"
    },
    "./errors": {
      "types": "./dist/src/entries/errors.d.ts",
      "default": "./dist/src/entries/errors.js"
    },
    "./backends": {
      "types": "./dist/src/entries/backends.d.ts",
      "default": "./dist/src/entries/backends.js"
    },
    "./envelope": {
      "types": "./dist/src/entries/envelope.d.ts",
      "default": "./dist/src/entries/envelope.js"
    },
    "./server": {
      "types": "./dist/src/server/handler.d.ts",
      "default": "./dist/src/server/handler.js"
    },
    "./resolve": {
      "types": "./dist/src/input/resolvers/bytecode.d.ts",
      "default": "./dist/src/input/resolvers/bytecode.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "default": "./dist/src/core/index.js"
    },
    "./table": {
      "types": "./dist/src/core/table.d.ts",
      "default": "./dist/src/core/table.js"
    },
    "./clients/sourcify": {
      "types": "./dist/src/clients/sourcify.d.ts",
      "default": "./dist/src/clients/sourcify.js"
    },
    "./clients/etherscan-v2": {
      "types": "./dist/src/clients/etherscan-v2.d.ts",
      "default": "./dist/src/clients/etherscan-v2.js"
    },
    "./clients/etherscan-compatible": {
      "types": "./dist/src/clients/etherscan-compatible.d.ts",
      "default": "./dist/src/clients/etherscan-compatible.js"
    },
    "./clients/routescan": {
      "types": "./dist/src/clients/routescan.d.ts",
      "default": "./dist/src/clients/routescan.js"
    },
    "./clients/blockscout": {
      "types": "./dist/src/clients/blockscout.d.ts",
      "default": "./dist/src/clients/blockscout.js"
    },
    "./envelope.schema.json": "./schema/envelope.schema.json",
    "./event.schema.json": "./schema/event.schema.json",
    "./input.schema.json": "./schema/input.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/",
    "src/",
    "schema/",
    "!**/*.test.*",
    "docs/",
    "skills/",
    "llms.txt",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node ../../scripts/package-docs.ts",
    "clean": "node -e \"for (const p of ['dist','coverage','docs','skills','llms.txt','reports']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "test": "pnpm run test:unit",
    "test:unit": "node ../../scripts/node-test.ts unit \"test/unit/**/*.test.ts\"",
    "test:randomize": "node ../../scripts/node-test.ts unit --test-randomize \"test/unit/**/*.test.ts\"",
    "coverage": "c8 --check-coverage node --test \"test/unit/**/*.test.ts\"",
    "test:mutation": "pnpm run build && stryker run --force && pnpm run mutation:check",
    "test:mutation:incremental": "pnpm run build && stryker run && pnpm run mutation:check",
    "mutation:check": "node ../../scripts/check-mutation-score.ts mutation-floors.json reports/mutation/mutation.json",
    "pkg:check": "publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm && node ../../scripts/check-packed-files.ts"
  },
  "devDependencies": {
    "@stryker-mutator/core": "catalog:",
    "@stryker-mutator/tap-runner": "catalog:",
    "ajv": "catalog:",
    "c8": "catalog:"
  }
}
