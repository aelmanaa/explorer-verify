    "src/Counter.sol": "// SPDX-License-Identifier: MIT\npragma solidity >=0.5.0 <0.9.0;\n\nimport \"./Tally.sol\";\n\ncontract Counter {\n    uint256 public count;\n\n    function bump(uint256 amount) public {\n        count = Tally.add(count, amount);\n    }\n}\n",
