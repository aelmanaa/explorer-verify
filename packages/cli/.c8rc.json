{
  "all": true,
  "src": ["src"],
  "include": ["src/**/*.ts"],
  "exclude": ["test/**"],
  "exclude-after-remap": true,
  "reporter": ["text", "lcov"],
  "reports-dir": "coverage",
  "check-coverage": true,
  "per-file": true,
  "lines": 95,
  "branches": 95,
  "functions": 95,
  "statements": 95
}
