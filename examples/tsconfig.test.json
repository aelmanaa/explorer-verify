{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../node_modules/.cache/tsbuild/examples-test",
    "tsBuildInfoFile": "../node_modules/.cache/tsbuild/examples-test.tsbuildinfo",
    // The browser-side files use DOM types; the Next.js route and the tests use Node types.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  // The examples import `explorer-verify/server` by name, as an application does, which resolves
  // to the built package. The reference builds it first.
  "references": [{ "path": "../packages/explorer-verify/tsconfig.build.json" }],
  "include": ["server-nextjs", "server-cloudflare", "test"]
}
