{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../node_modules/.cache/tsbuild/examples-test",
    "tsBuildInfoFile": "../node_modules/.cache/tsbuild/examples-test.tsbuildinfo",
    // The browser-side files use DOM types; the Next.js route and the tests use Node types.
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  // The examples import `explorer-verify`, `explorer-verify/server` and, in the dapp's export
  // script, `@explorer-verify/foundry` by name, as an application does, which resolves to each
  // built package. The references build them first, and let the type-aware lint read their
  // sources when no build exists.
  "references": [
    { "path": "../packages/explorer-verify/tsconfig.build.json" },
    { "path": "../packages/foundry/tsconfig.build.json" }
  ],
  "include": ["server-nextjs", "server-cloudflare", "dapp", "test"]
}
