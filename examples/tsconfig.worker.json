{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../node_modules/.cache/tsbuild/examples-worker",
    "tsBuildInfoFile": "../node_modules/.cache/tsbuild/examples-worker.tsbuildinfo",
    // The Worker checked again without Node types: it must use only web-platform globals, as
    // workerd provides them. DOM stands in for the Workers runtime types, so the example needs no
    // Cloudflare package.
    "lib": ["ES2023", "DOM"],
    "types": []
  },
  "references": [{ "path": "../packages/explorer-verify/tsconfig.build.json" }],
  "include": ["server-cloudflare/src"]
}
