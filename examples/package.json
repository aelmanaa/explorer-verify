{
  "name": "explorer-verify-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Example applications of explorer-verify: the server handler in a Next.js route and a Cloudflare Worker, and the dapp of the deploy-and-verify tutorial. Type-checked and tested in CI. Never published.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "pnpm run test:unit",
    "test:unit": "node ../scripts/node-test.ts unit \"test/**/*.test.ts\"",
    "test:randomize": "node ../scripts/node-test.ts unit --test-randomize \"test/**/*.test.ts\"",
    "coverage": "c8 --check-coverage node --test \"test/**/*.test.ts\"",
    "dapp:build": "node dapp/scripts/build.ts",
    "dapp:serve": "node dapp/scripts/serve.ts"
  },
  "dependencies": {
    "explorer-verify": "workspace:*",
    "viem": "2.57.14"
  },
  "devDependencies": {
    "@explorer-verify/foundry": "workspace:*",
    "c8": "catalog:",
    "esbuild": "catalog:"
  }
}
