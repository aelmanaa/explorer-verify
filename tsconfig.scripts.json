{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "node_modules/.cache/tsbuild/scripts",
    "tsBuildInfoFile": "node_modules/.cache/tsbuild/scripts.tsbuildinfo"
  },
  // The CLI reference generator imports the CLI's command table and help from source.
  "include": ["scripts", "site/.vitepress/config.ts", "site/api-reference.ts", "packages/cli/src"]
}
