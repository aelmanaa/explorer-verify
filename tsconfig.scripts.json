{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["ES2023", "DOM"],
    "outDir": "node_modules/.cache/tsbuild/scripts",
    "tsBuildInfoFile": "node_modules/.cache/tsbuild/scripts.tsbuildinfo"
  },
  // Live probes read internal flow seams from source; published declarations omit them.
  // The CLI reference generator imports the CLI's command table and help from source.
  "include": [
    "scripts",
    "site/.vitepress/config.ts",
    "site/.vitepress/theme",
    "site/api-reference.ts",
    "packages/cli/src",
    "packages/explorer-verify/src",
    "packages/explorer-verify/src/routing/table.json"
  ]
}
