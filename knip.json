{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/*.ts"]
    },
    "packages/explorer-verify": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts",
        "test/browser/entry.ts",
        "test/browser/broken/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/foundry": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
