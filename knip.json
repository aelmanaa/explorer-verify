{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["gpgconf"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/*.ts"]
    },
    "packages/explorer-verify": {
      "entry": [
        "src/index.ts",
        "src/server/handler.ts",
        "src/input/resolvers/bytecode.ts",
        "src/core/index.ts",
        "src/core/table.ts",
        "src/entries/*.ts",
        "src/clients/{sourcify,etherscan-v2,etherscan-compatible,routescan,blockscout}.ts",
        "test/**/*.test.ts",
        "test/browser/entry.ts",
        "test/browser/late-start.ts",
        "test/browser/broken/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/foundry": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/hardhat": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "examples": {
      "entry": [
        "server-nextjs/app/api/verify/route.ts",
        "server-nextjs/lib/verify-client.ts",
        "server-cloudflare/src/index.ts",
        "server-cloudflare/client/verify-client.ts",
        "dapp/src/main.ts",
        "dapp/scripts/*.ts",
        "test/**/*.test.ts"
      ],
      "project": ["**/*.ts"]
    },
    "packages/cli": {
      "entry": ["src/bin.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
