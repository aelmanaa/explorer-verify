{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "import", "jsdoc", "node", "promise", "oxc", "unicorn"],
  "jsPlugins": [
    {
      "name": "jsdoc-js",
      "specifier": "eslint-plugin-jsdoc"
    }
  ],
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "deny"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "node_modules/**",
    "validation/hardhat/project/**"
  ],
  "rules": {
    "eslint/no-console": "error",
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true,
        "checkTypeImports": true
      }
    ],
    "node/no-process-env": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/consistent-type-exports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": [
              "describe",
              "it",
              "test",
              "suite",
              "before",
              "after",
              "beforeEach",
              "afterEach"
            ]
          }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/only-throw-error": "error",
    "typescript/return-await": ["error", "always"],
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-explicit-any": "error",
    "jsdoc/no-blank-blocks": "error",
    "jsdoc/require-param-name": "error",
    "jsdoc-js/require-jsdoc": [
      "error",
      {
        "publicOnly": true,
        "enableFixer": false,
        "require": {
          "FunctionDeclaration": true,
          "ClassDeclaration": true,
          "MethodDefinition": true,
          "ArrowFunctionExpression": true
        }
      }
    ],
    "eslint/no-underscore-dangle": "error",
    "jsdoc/check-tag-names": [
      "error",
      {
        "definedTags": ["experimental", "packageDocumentation"]
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-enum-assignment": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/ban-ts-comment": "error"
  },
  "overrides": [
    {
      // JSON-driven JavaScript harnesses use runtime assertions instead of TypeScript narrowing.
      "files": ["validation/**/*.mjs"],
      "rules": {
        "typescript/strict-boolean-expressions": "off",
        "typescript/no-misused-promises": "off"
      }
    },
    {
      // Adoption consumers are application and test programs with stdout and process settings.
      "files": ["validation/**"],
      "rules": {
        "eslint/no-console": "off",
        "node/no-process-env": "off",
        "jsdoc-js/require-jsdoc": "off"
      }
    },
    {
      "files": ["packages/*/src/**"],
      "rules": {
        "import/no-nodejs-modules": "error"
      }
    },
    {
      "files": ["packages/foundry/src/**", "packages/hardhat/src/**"],
      "rules": {
        "import/no-nodejs-modules": "off"
      }
    },
    {
      // The CLI runs on Node only (decision 0008): it imports Node built-ins, and its bin reads
      // the environment and passes it in. The rest of its code takes the environment as a value.
      "files": ["packages/cli/src/**"],
      "rules": {
        "import/no-nodejs-modules": "off",
        // `import { env } from "node:process"` would get past no-process-env.
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "node:process",
                "message": "Only src/bin.ts reads the process; take what you need from Io."
              },
              {
                "name": "process",
                "message": "Only src/bin.ts reads the process; take what you need from Io."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/cli/src/bin.ts"],
      "rules": {
        "node/no-process-env": "off",
        "eslint/no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/*/test/**"],
      "rules": {
        "jsdoc-js/require-jsdoc": "off",
        "node/no-process-env": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/strict-boolean-expressions": "off"
      }
    },
    {
      // The examples are application code: a Next.js route reads its secret from process.env.
      "files": ["examples/server-nextjs/**"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      // Two dapp scripts read process.env: serve.ts reads PORT and ETHERSCAN_API_KEY, and
      // sepolia-run.ts reads SEPOLIA_PRIVATE_KEY, SEPOLIA_RPC_URL and ETHERSCAN_API_KEY.
      "files": ["examples/dapp/scripts/**"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["examples/test/**"],
      "rules": {
        "jsdoc-js/require-jsdoc": "off",
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["test/**"],
      "rules": {
        "jsdoc-js/require-jsdoc": "off",
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["**/*.mjs", "validation/**/*.cjs"],
      "rules": {
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-argument": "off"
      }
    }
  ]
}
